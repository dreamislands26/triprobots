PORT=8788
NODE_ENV=development

# OpenAI-compatible model endpoint. This service receives anonymized text only.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Shared secret used only between Russia ingress and agent logic.
AGENT_INTERNAL_KEY=

# Admin-only generation endpoint for marketing drafts.
MARKETING_ADMIN_KEY=

# Optional non-PII operational database. Do not store raw leads here.
DATABASE_URL=

# CRM / calendar adapters are connected through the Russia ingress or another approved service.
BITRIX24_WEBHOOK_URL=
CALENDAR_API_URL=
CALENDAR_API_TOKEN=

SITE_ORIGIN=https://triprobots.ru

# Safety / limits
MAX_MESSAGES_PER_MINUTE=12
DAILY_LLM_TOKEN_LIMIT=150000
