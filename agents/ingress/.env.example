PORT=8787
NODE_ENV=development

# PostgreSQL physically hosted in Russia. Raw personal data lives only here.
DATABASE_URL=

# Anonymized agent-logic service (e.g. Render)
AGENT_LOGIC_URL=
AGENT_INTERNAL_KEY=
AGENT_TIMEOUT_MS=6000

# Public site origin
SITE_ORIGIN=https://triprobots.ru
PUBLIC_PRIVACY_URL=https://triprobots.ru/privacy/

# Telegram front-office bot. Webhook must point to this Russia ingress service.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Abuse protection
MAX_REQUESTS_PER_MINUTE=12
HONEYPOT_FIELD=website
